  "STM32 Bare-Metal Register LED Toggle": {
    "prefix": "stm32_reg_toggle",
    "body": [
      "/* Enable GPIO Port Clock */",
      "RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;",
      "/* Configure Pin as General Purpose Output */",
      "GPIOA->MODER &= ~(3U << (5 * 2));",
      "GPIOA->MODER |=  (1U << (5 * 2));",
      "/* Toggle Pin in loop */",
      "GPIOA->ODR ^= (1U << 5);$0"
    ],
    "description": "Direct bare-metal register manipulation for GPIO output toggle (e.g. PA5 LED on Nucleo)"
  },
