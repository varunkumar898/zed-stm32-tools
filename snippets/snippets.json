  "CMSIS DWT Microsecond Delay": {
    "prefix": "cmsis_delay_us",
    "body": [
      "void delay_us(uint32_t us) {",
      "    uint32_t start = DWT->CYCCNT;",
      "    uint32_t ticks = us * (SystemCoreClock / 1000000UL);",
      "    while ((DWT->CYCCNT - start) < ticks);",
      "}$0"
    ],
    "description": "Accurate non-blocking microsecond delay function using Cortex-M DWT counter"
  },
