  "STM32 HardFault Handler Diagnostics": {
    "prefix": "stm32_hardfault_handler",
    "body": [
      "void HardFault_Handler(void) {",
      "    __asm volatile (",
      "        \" tst lr, #4            \\n\"",
      "        \" ite eq                 \\n\"",
      "        \" mrseq r0, msp          \\n\"",
      "        \" mrsne r0, psp          \\n\"",
      "        \" ldr r1, [r0, #24]      \\n\"",
      "        \" bkpt #0                \\n\"",
      "    );",
      "    while (1) {}",
      "}$0"
    ],
    "description": "Detailed Cortex-M HardFault exception handler that captures fault PC into R1 and halts in debugger"
  }
